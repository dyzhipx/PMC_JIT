# ══════════════════════════════════════
#  Salin file ini menjadi ".env" dan isi nilainya
#  cp .env.example .env
# ══════════════════════════════════════

# Database (SQL Server)
DATABASE_URL="sqlserver://localhost:1433;database=pmc_db;integratedSecurity=true;trustServerCertificate=true"

# Server
PORT=3000
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET=ganti-dengan-secret-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Frontend Origins (pisah dengan koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:5137
