{
  "name": "pmc-server",
  "version": "1.0.0",
  "description": "PMC Material Calculator — Backend API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
